<!-- FAQ -->
<section class="faq-section"> 
<div class="container">

<div class="text-center mb-5">
<h5 class="section-tag">FAQ</h5>
<h2 class="section-title">Frequently Asked Questions About Data Science</h2></div>

<div class="faq-container">

<div class="faq-item">
<button type="button" class="faq-question">
What is data science?
<span class="icon">+</span>
</button>
<div class="faq-answer">
<p>
Data science is the process of analyzing large datasets using statistical and computational techniques 
to extract meaningful insights and support decision-making.
</p></div>
</div>

<div class="faq-item">
<button type="button" class="faq-question">
How can data science help my business?
<span class="icon">+</span>
</button>
<div class="faq-answer">
<p>
Data science helps businesses improve decision-making, optimize operations, understand customer behavior, 
and identify new growth opportunities.
</p></div>
</div>
    <div class="faq-item">
<button type="button" class="faq-question">
What is machine learning in data science?
<span class="icon">+</span>
</button>
<div class="faq-answer">
<p>
Machine learning is a subset of data science that focuses on building intelligent models that learn from data 
and improve automatically over time without being explicitly programmed. It helps businesses automate decisions, 
predict outcomes, and enhance system performance.
</p>
</div>
</div>

<div class="faq-item">
<button type="button" class="faq-question">
Do you provide custom data solutions?
<span class="icon">+</span>
</button>
<div class="faq-answer">
<p>
Yes, data science solutions can be customized based on business needs, industry requirements, and available data.
</p></div>
</div>

</div>

</div>
</section>
     <script>
     const faqItems = document.querySelectorAll(".faq-item");

     faqItems.forEach(item => {
         const btn = item.querySelector(".faq-question");

         btn.addEventListener("click", (e) => {
             e.preventDefault(); // important

             faqItems.forEach(i => {
                 if (i !== item) {
                     i.classList.remove("active");
                 }
             });

             item.classList.toggle("active");
         });
     });


     </script>

